# The impairment sidecar: a container that does nothing but shape another
# container's link. Kept deliberately tiny and separate from the R images.
FROM alpine:3.20
RUN apk add --no-cache iproute2
COPY docker/netem.sh /usr/local/bin/netem.sh
RUN chmod +x /usr/local/bin/netem.sh
ENTRYPOINT ["/bin/sh", "/usr/local/bin/netem.sh"]
